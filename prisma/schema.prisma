generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== 사용자 ==========

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @db.VarChar(50)
  nickname     String   @unique @db.VarChar(30)
  passwordHash String
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workouts     Workout[]
  posts        Post[]
  groupMembers GroupMember[]

  @@index([email])
  @@index([nickname])
}

// ========== 운동 종류 ==========

enum ExerciseCategory {
  CARDIO
  STRENGTH
  FLEXIBILITY
  SPORTS
  OTHER
}

model ExerciseType {
  id        Int              @id @default(autoincrement())
  name      String           @unique @db.VarChar(50)
  category  ExerciseCategory
  icon      String?          @db.VarChar(10)
  isDefault Boolean          @default(true)
  createdAt DateTime         @default(now())

  workouts Workout[]

  @@index([category])
}

// ========== 운동 기록 ==========

model Workout {
  id             String       @id @default(cuid())
  userId         String
  exerciseTypeId Int
  date           DateTime     @db.Date
  startTime      DateTime?
  durationMin    Int
  distanceKm     Float?
  calories       Int?
  intensity      Int?         @default(3)
  memo           String?      @db.Text
  isVerified     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseType ExerciseType @relation(fields: [exerciseTypeId], references: [id])
  photos       WorkoutPhoto[]

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model WorkoutPhoto {
  id         String   @id @default(cuid())
  workoutId  String
  filePath   String   @db.VarChar(500)
  fileName   String   @db.VarChar(255)
  fileSize   Int
  mimeType   String   @db.VarChar(50)
  uploadedAt DateTime @default(now())

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
}

// ========== 게시글 ==========

model Post {
  id        String   @id @default(cuid())
  userId    String
  workoutId String?
  title     String   @db.VarChar(200)
  content   String   @db.Text
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// ========== 그룹 ==========

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model Group {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  inviteCode  String   @unique @db.VarChar(20)
  weeklyGoal  Int      @default(3)
  finePerMiss Int      @default(5000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  fineRecords FineRecord[]

  @@index([inviteCode])
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// ========== 벌금 ==========

model FineRecord {
  id            String    @id @default(cuid())
  groupId       String
  userId        String
  weekStart     DateTime  @db.Date
  weekEnd       DateTime  @db.Date
  workoutCount  Int
  requiredCount Int
  missedCount   Int
  fineAmount    Int
  isPaid        Boolean   @default(false)
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId, weekStart])
  @@index([groupId, weekStart(sort: Desc)])
  @@index([userId, weekStart(sort: Desc)])
}